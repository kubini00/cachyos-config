{
  "layer": "top",
  "spacing": 6,
  "position": "top",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "ipc": false,
  "reload_style_on_change": true,
  "height": 36,
  "modules-left": [
    "ext/workspaces"
  ],
  "modules-center": [
    "custom/playerctl"
  ],
  "modules-right": [
    "tray",
    "pulseaudio#microphone",
    "pulseaudio",
    "clock",
    "custom/multimenu"
  ],
  "ext/workspaces": {
    "ignore-hidden": false,
    "on-click": "activate",
    "on-click-right": "deactivate"
  },
  "tray": {
    "interval": 1,
    "icon-size": 20,
    "spacing": 12
  },
  "clock": {
    "format": "{:%H:%M ~ %d/%m/%y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "weeks-pos": "right",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
        "months": "<span color='white'><b>{}</b></span>",
        "days": "<span color='whitesmoke'><b>{}</b></span>",
        "weeks": "<span color='lime'><b>{}</b></span>",
        "weekdays": "<span color='yellow'><b>{}</b></span>",
        "today": "<span color='red'><b><u>{}</u></b></span>"
      }
    }
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "tooltip": false,
    "format-muted": " {volume}%",
    "on-click": "pamixer -t",
    "on-scroll-up": "pamixer -i 2",
    "on-scroll-down": "pamixer -d 2",
    "on-click-middle": "pavucontrol",
    "on-click-right": "~/.config/rofi/audio/audio-menu.sh",
    "scroll-step": 0,
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "",
    "tooltip": false,
    "scroll-step": 0,
    "format-source-muted": "",
    "on-click": "pamixer --default-source -t"
  },
  "custom/multimenu": {
    "format": "󰣇",
    "tooltip": false,
    "on-click-right": "sleep 0.1s && swaync-client -t -sw",
    "on-click-middle": "~/.config/rofi/launch/launcher.sh",
    "on-click": "sh ~/.config/rofi/power/powermenu.sh"
  },
  "custom/playerctl": {
    "format": "{2}<span>{0}</span>",
    "return-type": "json",
    "max-length": 80,
    "exec": "playerctl -p limusic -F metadata -f '{\"text\": \"{{markup_escape(title)}} - {{markup_escape(artist)}}\", \"tooltip\": \"{{markup_escape(title)}} - {{markup_escape(artist)}}  {{ duration(position) }}/{{ duration(mpris:length) }}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
    "tooltip": true,
    "on-click-middle": "playerctl -p limusic previous",
    "on-click": "playerctl -p limusic play-pause",
    "on-click-right": "playerctl -p limusic next",
    "on-click-forward": "playerctl -p limusic position 10+",
    "on-click-backward": "playerctl -p limusic position 10-",
    "on-scroll-up": "playerctl -p limusic volume 0.02+",
    "on-scroll-down": "playerctl -p limusic volume 0.02-",
    "format-icons": {
      "Paused": " ",
      "Playing": " "
    }
  }
}
