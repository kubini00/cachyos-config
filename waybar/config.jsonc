{
  "layer": "top",
  "spacing": 8, 
  "position": "top",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "ipc": false,
  "reload_style_on_change": true,
  "height": 42,
  "modules-left": [
    "ext/workspaces"
  //  "wlr/taskbar"
  ],
  "modules-center": [
    "custom/playerctl",
    "clock"
    // "custom/cava",
  ],
  "modules-right": [
    "tray",
    "pulseaudio#microphone",
    "pulseaudio",
    "custom/notification",
    "custom/power"
  ],

  // "dwl/tags": {
  //   "num-tags": 9,
  //   "hide-vacant": true,
  //   "tag-labels": ["!", "@", "#", "$", "%", "^", "&", "*", "="]
  //   // "tag-labels": ["", "", "", "", "", "", "", "", ""]
  // },

"ext/workspaces": {
    "ignore-hidden": false,
    "on-click": "activate",
    "on-click-right": "deactivate"
  },

  
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "sleep 0.1s && swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
 
  "tray": {
    "interval": 1,
    "icon-size": 20,
    "spacing": 12
  },
  
  "clock": {
    "format": "{:%H:%M ~ %d/%m/%y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "weeks-pos": "right",
      "mode-mon-col" : 3,
      "on-scroll": 1,
      "format": {
        "months": "<span color='white'><b>{}</b></span>",
        "days": "<span color='whitesmoke'><b>{}</b></span>",
        "weeks": "<span color='lime'><b>{}</b></span>",
        "weekdays": "<span color='yellow'><b>{}</b></span>",
        "today": "<span color='red'><b><u>{}</u></b></span>"
      }
    }
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "tooltip": false,
    "format-muted": " Mute",
    "on-click": "pamixer -t",
    "on-scroll-up": "pamixer -i 2",
    "on-scroll-down": "pamixer -d 2",
    "on-click-right": "pavucontrol",
    "scroll-step": 5,
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "sh ~/.config/rofi/power/powermenu.sh"
    // "on-click-right": "bash ~/.config/eww/System-Menu/launch"
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "",
    "tooltip": false,
    "format-source-muted": "",
    "on-click": "pamixer --default-source -t",
    "scroll-step": 5
  },
  // "custom/playerctl": {
  //     "format": "{2} <span>{0}</span>",
  //     "return-type": "json",
  //     "exec": "playerctl  metadata -f '{\"text\": \"{{markup_escape(title)}} - {{markup_escape(artist)}}  {{ duration(position) }}|{{ duration(mpris:length) }}\", \"tooltip\": \"{{markup_escape(title)}} - {{markup_escape(artist)}}  {{ duration(position) }}/{{ duration(mpris:length) }}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
  //     "tooltip": false,
  //     "on-click-middle": "playerctl  previous",
  //     "on-click": "playerctl  play-pause",
  //     "on-click-right": "playerctl  next",
  //     "on-click-forward": "playerctl  position 10+",
  //     "on-click-backward": "playerctl  position 10-",
  //     "on-scroll-up": "playerctl  volume 0.02+",
  //     "on-scroll-down": "playerctl  volume 0.02-",
  //     "format-icons": {
  //         "Paused": " ",
  //         "Playing": " "
  //     }
  // },
// "custom/cava": {
//     "exec": "~/.config/mango/cava.sh",
//     "format": "  {}"
// },


  "custom/playerctl": {
    "format": "{2}<span>{0}</span>",
    "return-type": "json",
    "max-length": 80,
    "exec": "playerctl -p chromium -F metadata -f '{\"text\": \"{{markup_escape(title)}} - {{markup_escape(artist)}}\", \"tooltip\": \"{{markup_escape(title)}} - {{markup_escape(artist)}}  {{ duration(position) }}/{{ duration(mpris:length) }}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
    "tooltip": true,
    "on-click-middle": "playerctl -p chromium previous",
    "on-click": "playerctl -p chromium play-pause",
    "on-click-right": "playerctl -p chromium next",
    "on-click-forward": "playerctl -p chromium position 10+",
    "on-click-backward": "playerctl -p chromium position 10-",
    "on-scroll-up": "playerctl -p chromium volume 0.02+",
    "on-scroll-down": "playerctl -p chromium volume 0.02-",
    "format-icons": {
      "Paused": " ",
      "Playing": " "
    }
  }
  
}
