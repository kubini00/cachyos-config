{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        //"source": "~/.config/fastfetch/img/logo.png",
        "type": "small",
        "width": 23,
        "padding": {
            "right": 4,
            "top": 1,
            "left": 1
        }
    },
    "display": {
        "separator": "  ",
        "constants": [
            "──────────────────",
            "            "
        ]
    },
    "modules": [
        {
            "type": "title",
            "format": "{$2}{user-name} ~ {host-name}",
            "outputColor":"cyan"
        },
        
        {
            "type": "custom",
            "format": "╭{$1}─{$1}╮"
        },
        {
            "type": "os",
            "key": "   {icon}",
            "format": "{pretty-name}",
            "keyColor": "magenta"
            
        },
        {
            "type": "packages",
            "key": "   {icon}",
            "format": "pacman  ({pacman})",
            "keyColor": "magenta"
        },
        {
            "type": "uptime",
            "key": "   {icon}",
            "keyColor": "magenta"
        },
        // {
        //     "type": "custom",
        //     "format": "├{$1}─{$1}┤"
        // },
        // {
        //     "type": "custom",
        //     "format": "╭{$1}─{$1}╮"
        // },
        // {
            //     "type": "packages",
            //     "key": "{icon}",
            //     "format": "xbps / {xbps}",
            //     "keyColor": "magenta"
            // },
            {
                "type": "wm",
                "key": "   {icon}",
                "format": "{pretty-name}",
                "keyColor": "yellow"
    
            },
            {
                "type": "shell",
                "key": "   {icon}",
                "format": "{pretty-name}",
                "keyColor": "yellow"
            },
            {
                "type": "terminal",
                "key": "   {icon}",
                "format": "{pretty-name}",
                "keyColor": "yellow"
            },
            // {
            // "type": "custom",
            // "format": "├{$1}─{$1}┤"
            // },
        //     {
        //     "type": "custom",
        //     "format": "╭{$1}─{$1}╮"
        // },
        // {
        //     "type": "terminalfont",
        //     "key": "{icon}",
        //     "format": "{name}",
        //     "keyColor": "yellow"
        // },
        {
            "type": "cpu",
            "key": "   {icon}",
            "format": "{name} {freq-max}",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "   {icon}",
            "format": "{vendor} {name}",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "   {icon}",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "   {icon}",
            "format": "{size-used} / {size-total} ({size-percentage})",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "╰{$1}─{$1}╯"
        }
        // ,"break",
        // "colors"
    ]
}
